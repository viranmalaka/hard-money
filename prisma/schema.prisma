generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                           String            @id @default(uuid())
  name                         String
  email                        String            @unique
  passwordHash                 String?
  defaultCurrency              String            @default("LKR")
  timezone                     String            @default("Asia/Colombo")
  countryCode                  String?
  defaultWithholdingTaxRateBps Int               @default(0)
  apiKeyHash                   String?
  apiKeyPrefix                 String?
  geminiApiKeyEncrypted        String?
  geminiModel                  String?
  smsAutoPostMode              String            @default("AUTO_VALIDATED")
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt

  ownedHouseholds              Household[]       @relation("HouseholdOwner")
  householdMembers             HouseholdMember[]
  categories                   Category[]
  accounts                     Account[]
  transactions                 Transaction[]
}

model Household {
  id        String            @id @default(uuid())
  name      String
  ownerId   String
  owner     User              @relation("HouseholdOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   HouseholdMember[]
  createdAt DateTime          @default(now())
}

model HouseholdMember {
  id          String    @id @default(uuid())
  householdId String
  userId      String
  role        String    @default("OWNER")
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([householdId, userId])
}

model Category {
  id          String    @id @default(uuid())
  userId      String?
  householdId String?
  name        String
  icon        String    @default("Tag")
  color       String    @default("#6B7075")
  serverSeq   BigInt    @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  splitItems   TransactionSplitItem[]

  @@index([userId])
  @@index([serverSeq])
}

model Account {
  id                         String    @id @default(uuid())
  userId                     String
  householdId                String?
  name                       String
  type                       String    // CASH | BANK_SAVINGS | CREDIT_CARD
  openingBalanceMinor        Int       @default(0)
  balanceCacheMinor          Int?
  currency                   String    @default("LKR")
  accountNumberLast4         String?
  bankSenderIds              String[]  @default([])
  accessScope                String    @default("PRIVATE") // PRIVATE | SHARED_HOUSEHOLD
  feeRules                   Json?
  creditLimitMinor           Int?
  statementCutoffDay         Int?
  paymentDueDay              Int?
  linkedSettlementAccountId  String?
  isArchived                 Boolean   @default(false)
  serverSeq                  BigInt    @default(0)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  deletedAt                  DateTime?

  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions               Transaction[] @relation("AccountTransactions")
  transfersTo                Transaction[] @relation("TransferToAccount")

  @@index([userId])
  @@index([householdId])
  @@index([serverSeq])
}

model Transaction {
  id                           String    @id @default(uuid())
  userId                       String
  householdId                  String?
  accountId                    String
  toAccountId                  String?
  categoryId                   String?
  amountMinor                  Int
  direction                    String?   // IN | OUT
  type                         String    // EXPENSE | INCOME | TRANSFER | REFUND | ADJUSTMENT
  subType                      String?
  source                       String    @default("MANUAL")
  createdByUserId              String
  updatedByUserId              String
  transactionDate              DateTime
  note                         String?
  isSplit                      Boolean   @default(false)
  excludeFromBudget            Boolean   @default(false)
  excludeFromStats             Boolean   @default(false)
  excludeFromBalance           Boolean   @default(false)
  serverSeq                    BigInt    @default(0)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  deletedAt                    DateTime?

  user                         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account                      Account   @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  toAccount                    Account?  @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)
  category                     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  splitItems                   TransactionSplitItem[]

  @@index([userId])
  @@index([accountId])
  @@index([transactionDate])
  @@index([serverSeq])
}

model TransactionSplitItem {
  id            String      @id @default(uuid())
  transactionId String
  categoryId    String
  amountMinor   Int
  note          String?

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

model AppliedMutation {
  id        String   @id // mutationId
  userId    String
  appliedAt DateTime @default(now())

  @@index([userId])
}

model SyncSequence {
  id  Int    @id @default(1)
  seq BigInt @default(0)
}
