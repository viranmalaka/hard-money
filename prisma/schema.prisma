generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                           String            @id @default(uuid())
  name                         String
  email                        String            @unique
  passwordHash                 String?
  defaultCurrency              String            @default("LKR")
  timezone                     String            @default("Asia/Colombo")
  countryCode                  String?
  defaultWithholdingTaxRateBps Int               @default(0)
  apiKeyHash                   String?
  apiKeyPrefix                 String?
  geminiApiKeyEncrypted        String?
  geminiModel                  String?
  smsAutoPostMode              String            @default("AUTO_VALIDATED")
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt

  ownedHouseholds              Household[]       @relation("HouseholdOwner")
  householdMembers             HouseholdMember[]
  categories                   Category[]
  accounts                     Account[]
  transactions                 Transaction[]
  templates                    TransactionTemplate[]
  budgets                      Budget[]
  budgetSnapshots              BudgetMonthSnapshot[]
  creditCardStatements         CreditCardStatement[]
  installmentPlans             CreditCardInstallmentPlan[]
  bankSmsList                  BankSms[]
}

model Household {
  id        String            @id @default(uuid())
  name      String
  ownerId   String
  owner     User              @relation("HouseholdOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   HouseholdMember[]
  createdAt DateTime          @default(now())
}

model HouseholdMember {
  id          String    @id @default(uuid())
  householdId String
  userId      String
  role        String    @default("OWNER")
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([householdId, userId])
}

model Category {
  id          String    @id @default(uuid())
  userId      String?
  householdId String?
  name        String
  icon        String    @default("Tag")
  color       String    @default("#6B7075")
  serverSeq   BigInt    @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  splitItems   TransactionSplitItem[]
  budgets      Budget[]
  budgetSnapshots BudgetMonthSnapshot[]
  installmentPlans CreditCardInstallmentPlan[]

  @@index([userId])
  @@index([serverSeq])
}

model Account {
  id                         String    @id @default(uuid())
  userId                     String
  householdId                String?
  name                       String
  type                       String    // CASH | BANK_SAVINGS | CREDIT_CARD
  openingBalanceMinor        Int       @default(0)
  balanceCacheMinor          Int?
  currency                   String    @default("LKR")
  accountNumberLast4         String?
  bankSenderIds              String[]  @default([])
  accessScope                String    @default("PRIVATE") // PRIVATE | SHARED_HOUSEHOLD
  feeRules                   Json?
  creditLimitMinor           Int?
  statementCutoffDay         Int?
  paymentDueDay              Int?
  linkedSettlementAccountId  String?
  isArchived                 Boolean   @default(false)
  serverSeq                  BigInt    @default(0)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  deletedAt                  DateTime?

  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions               Transaction[] @relation("AccountTransactions")
  transfersTo                Transaction[] @relation("TransferToAccount")
  creditCardStatements       CreditCardStatement[]
  installmentPlans           CreditCardInstallmentPlan[]

  @@index([userId])
  @@index([householdId])
  @@index([serverSeq])
}

model Transaction {
  id                           String    @id @default(uuid())
  userId                       String
  householdId                  String?
  accountId                    String
  toAccountId                  String?
  categoryId                   String?
  amountMinor                  Int
  direction                    String?   // IN | OUT
  type                         String    // EXPENSE | INCOME | TRANSFER | REFUND | ADJUSTMENT
  subType                      String?
  source                       String    @default("MANUAL")
  createdByUserId              String
  updatedByUserId              String
  transactionDate              DateTime
  note                         String?
  isSplit                      Boolean   @default(false)
  excludeFromBudget            Boolean   @default(false)
  excludeFromStats             Boolean   @default(false)
  excludeFromBalance           Boolean   @default(false)
  serverSeq                    BigInt    @default(0)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  deletedAt                    DateTime?
  reversalOfTransactionId      String?

  user                         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account                      Account   @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  toAccount                    Account?  @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)
  category                     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  splitItems                   TransactionSplitItem[]
  reversalOf                   Transaction?  @relation("TransactionReversals", fields: [reversalOfTransactionId], references: [id], onDelete: SetNull)
  reversals                    Transaction[] @relation("TransactionReversals")
  installmentPlanId            String?
  installmentPlan              CreditCardInstallmentPlan? @relation("PlanTransactions", fields: [installmentPlanId], references: [id], onDelete: SetNull)
  bankSmsList                  BankSms[]

  @@index([userId])
  @@index([accountId])
  @@index([installmentPlanId])
  @@index([transactionDate])
  @@index([serverSeq])
}

model TransactionTemplate {
  id                 String    @id @default(uuid())
  userId             String
  name               String
  accountId          String?
  toAccountId        String?
  categoryId         String?
  type               String    @default("EXPENSE") // EXPENSE | INCOME | TRANSFER
  defaultAmountMinor Int?
  note               String?
  icon               String?
  serverSeq          BigInt    @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([serverSeq])
}

model TransactionSplitItem {
  id            String      @id @default(uuid())
  transactionId String
  categoryId    String
  amountMinor   Int
  note          String?

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

model AppliedMutation {
  id        String   @id // mutationId
  userId    String
  appliedAt DateTime @default(now())

  @@index([userId])
}

model SyncSequence {
  id  Int    @id @default(1)
  seq BigInt @default(0)
}

model Budget {
  id                 String    @id @default(uuid())
  userId             String
  categoryId         String
  monthlyLimitMinor  Int
  enableRollover     Boolean   @default(false)
  rolloverStartMonth String?   // YYYY-MM
  serverSeq          BigInt    @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category           Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  snapshots          BudgetMonthSnapshot[]

  @@unique([userId, categoryId])
  @@index([userId])
  @@index([serverSeq])
}

model BudgetMonthSnapshot {
  id                 String    @id // deterministic: snap_<userId>_<categoryId>_<YYYY-MM>
  userId             String
  budgetId           String
  categoryId         String
  month              String    // YYYY-MM
  limitMinor         Int
  spentMinor         Int
  carriedInMinor     Int       @default(0)
  carriedOutMinor    Int       @default(0)
  serverSeq          BigInt    @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  budget             Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category           Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
  @@index([userId])
  @@index([budgetId])
}

model CreditCardStatement {
  id                   String    @id // deterministic: stmt_<accountId>_<cycleDate>
  userId               String
  accountId            String
  cycleStartDate       DateTime
  cycleCutoffDate      DateTime
  dueDate              DateTime
  billedDebtMinor      Int
  totalDebtMinor       Int
  isSettled            Boolean   @default(false)
  serverSeq            BigInt    @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account              Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, cycleCutoffDate])
  @@index([userId])
  @@index([accountId])
}

model CreditCardInstallmentPlan {
  id                          String        @id @default(uuid())
  userId                      String
  accountId                   String
  categoryId                  String?
  merchantName                String
  totalAmountMinor            Int
  tenureMonths                Int
  monthlyAmountMinor          Int
  finalInstallmentAmountMinor Int
  initialPaidInstallments     Int           @default(0)
  processingFeeMinor          Int           @default(0)
  processingFeeBilled         Boolean       @default(false)
  startDate                   DateTime
  firstStatementDate          DateTime
  isOngoingSetup              Boolean       @default(false)
  status                      String        @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  originalTransactionId       String?
  note                        String?
  serverSeq                   BigInt        @default(0)
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt
  deletedAt                   DateTime?

  user                        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account                     Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category                    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions                Transaction[] @relation("PlanTransactions")

  @@index([userId])
  @@index([accountId])
  @@index([serverSeq])
}

model BankSms {
  id               String       @id @default(uuid())
  userId           String
  dedupeKey        String       @unique
  sender           String
  rawMessage       String
  receivedAt       DateTime
  status           String       @default("PENDING") // PENDING | PROCESSED | NEEDS_REVIEW | IGNORED_NON_TX | DUPLICATE | FAILED
  parseMethod      String?      // TEMPLATE | GEMINI
  parsedPayload    Json?
  reviewReason     String?      // ACCOUNT_UNMATCHED | LOW_CONFIDENCE | VALIDATION_FAILED | NO_GEMINI_KEY | POSSIBLE_DUPLICATE
  attempts         Int          @default(0)
  nextRetryAt      DateTime?
  transactionId    String?
  failureReason    String?
  createdAt        DateTime     @default(now())

  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction      Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([transactionId])
}

