generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                           String            @id @default(uuid())
  name                         String
  email                        String            @unique
  passwordHash                 String?
  defaultCurrency              String            @default("LKR")
  timezone                     String            @default("Asia/Colombo")
  countryCode                  String?
  defaultWithholdingTaxRateBps Int               @default(0)
  apiKeyHash                   String?
  apiKeyPrefix                 String?
  apiKeyEncrypted              String?
  geminiApiKeyEncrypted        String?
  geminiModel                  String?
  smsAutoPostMode              String            @default("AUTO_VALIDATED")
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt
  sessionVersion               Int               @default(0)

  ownedHouseholds              Household[]       @relation("HouseholdOwner")
  householdMembers             HouseholdMember[]
  categories                   Category[]
  accounts                     Account[]
  transactions                 Transaction[]
  templates                    TransactionTemplate[]
  budgets                      Budget[]
  budgetSnapshots              BudgetMonthSnapshot[]
  creditCardStatements         CreditCardStatement[]
  installmentPlans             CreditCardInstallmentPlan[]
  bankSmsList                  BankSms[]
  fixedDeposits                FixedDeposit[]
  loans                        Loan[]
  pushRemindersEnabled         Boolean                   @default(false)
  dailyReminderTime            String                    @default("20:00")
  pushSubscriptions            PushSubscription[]
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Household {
  id        String            @id @default(uuid())
  name      String
  ownerId   String
  owner     User              @relation("HouseholdOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   HouseholdMember[]
  shoppingListItems ShoppingListItem[]
  createdAt DateTime          @default(now())
}

model HouseholdMember {
  id          String    @id @default(uuid())
  householdId String
  userId      String
  role        String    @default("OWNER")
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([householdId, userId])
}

model ShoppingListItem {
  id          String    @id @default(uuid())
  householdId String
  name        String
  quantity    String?
  isCompleted Boolean   @default(false)
  position    Int       @default(0)
  completedAt DateTime?
  serverSeq   BigInt    @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([serverSeq])
  @@index([householdId, isCompleted, position])
}

model Category {
  id          String    @id @default(uuid())
  userId      String?
  householdId String?
  name        String
  icon        String    @default("Tag")
  color       String    @default("#6B7075")
  type        String    @default("EXPENSE") // EXPENSE | INCOME
  serverSeq   BigInt    @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  splitItems   TransactionSplitItem[]
  budgets      Budget[]
  budgetSnapshots BudgetMonthSnapshot[]
  installmentPlans CreditCardInstallmentPlan[]

  @@index([userId])
  @@index([serverSeq])
}

model Account {
  id                         String    @id @default(uuid())
  userId                     String
  householdId                String?
  name                       String
  type                       String    // CASH | BANK_SAVINGS | CREDIT_CARD
  openingBalanceMinor        Int       @default(0)
  balanceCacheMinor          Int?
  currency                   String    @default("LKR")
  accountNumberLast4         String?
  bankSenderIds              String[]  @default([])
  accessScope                String    @default("PRIVATE") // PRIVATE | SHARED_HOUSEHOLD
  feeRules                   Json?
  ownAtmFeeMinor             Int?              @default(0)
  otherAtmFeeMinor           Int?              @default(0)
  balanceMismatchHint        Json?
  creditLimitMinor           Int?
  statementCutoffDay         Int?
  paymentDueDay              Int?
  linkedSettlementAccountId  String?
  isArchived                 Boolean   @default(false)
  serverSeq                  BigInt    @default(0)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  deletedAt                  DateTime?

  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions               Transaction[] @relation("AccountTransactions")
  transfersTo                Transaction[] @relation("TransferToAccount")
  creditCardStatements       CreditCardStatement[]
  installmentPlans           CreditCardInstallmentPlan[]
  fdPayoutAccounts           FixedDeposit[]            @relation("FdPayoutAccount")
  fdFundingAccounts          FixedDeposit[]            @relation("FdFundingAccount")
  loanDisbursements          Loan[]                    @relation("LoanDisbursementAccount")

  @@index([userId])
  @@index([householdId])
  @@index([serverSeq])
}

model Transaction {
  id                           String    @id @default(uuid())
  userId                       String
  householdId                  String?
  accountId                    String
  toAccountId                  String?
  categoryId                   String?
  amountMinor                  Int
  direction                    String?   // IN | OUT
  type                         String    // EXPENSE | INCOME | TRANSFER | REFUND | ADJUSTMENT
  subType                      String?
  source                       String    @default("MANUAL")
  createdByUserId              String
  updatedByUserId              String
  transactionDate              DateTime
  note                         String?
  isSplit                      Boolean   @default(false)
  excludeFromBudget            Boolean   @default(false)
  excludeFromStats             Boolean   @default(false)
  excludeFromBalance           Boolean   @default(false)
  serverSeq                    BigInt    @default(0)
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  deletedAt                    DateTime?
  reversalOfTransactionId      String?

  user                         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account                      Account   @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  toAccount                    Account?  @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)
  category                     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  splitItems                   TransactionSplitItem[]
  reversalOf                   Transaction?  @relation("TransactionReversals", fields: [reversalOfTransactionId], references: [id], onDelete: SetNull)
  reversals                    Transaction[] @relation("TransactionReversals")
  installmentPlanId            String?
  installmentPlan              CreditCardInstallmentPlan? @relation("PlanTransactions", fields: [installmentPlanId], references: [id], onDelete: SetNull)
  feeTransactionId             String?
  feeParent                    Transaction?  @relation("FeeParentChild", fields: [feeTransactionId], references: [id], onDelete: SetNull)
  feeChildren                  Transaction[] @relation("FeeParentChild")
  possibleDuplicateOfTransactionId String?
  bankSmsList                  BankSms[]
  fdPayouts                    FixedDepositPayout[]
  loanPayments                 LoanPayment[]

  @@index([userId])
  @@index([accountId])
  @@index([installmentPlanId])
  @@index([transactionDate])
  @@index([serverSeq])
}

model TransactionTemplate {
  id                 String    @id @default(uuid())
  userId             String
  name               String
  accountId          String?
  toAccountId        String?
  categoryId         String?
  type               String    @default("EXPENSE") // EXPENSE | INCOME | TRANSFER
  defaultAmountMinor Int?
  note               String?
  icon               String?
  serverSeq          BigInt    @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([serverSeq])
}

model TransactionSplitItem {
  id            String      @id @default(uuid())
  transactionId String
  categoryId    String
  amountMinor   Int
  note          String?

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

model AppliedMutation {
  id        String   @id // mutationId
  userId    String
  appliedAt DateTime @default(now())

  @@index([userId])
}

model SyncSequence {
  id  Int    @id @default(1)
  seq BigInt @default(0)
}

model Budget {
  id                 String    @id @default(uuid())
  userId             String
  categoryId         String
  monthlyLimitMinor  Int
  enableRollover     Boolean   @default(false)
  rolloverStartMonth String?   // YYYY-MM
  serverSeq          BigInt    @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category           Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  snapshots          BudgetMonthSnapshot[]

  @@unique([userId, categoryId])
  @@index([userId])
  @@index([serverSeq])
}

model BudgetMonthSnapshot {
  id                 String    @id // deterministic: snap_<userId>_<categoryId>_<YYYY-MM>
  userId             String
  budgetId           String
  categoryId         String
  month              String    // YYYY-MM
  limitMinor         Int
  spentMinor         Int
  carriedInMinor     Int       @default(0)
  carriedOutMinor    Int       @default(0)
  serverSeq          BigInt    @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  budget             Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category           Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
  @@index([userId])
  @@index([budgetId])
}

model CreditCardStatement {
  id                   String    @id // deterministic: stmt_<accountId>_<cycleDate>
  userId               String
  accountId            String
  cycleStartDate       DateTime
  cycleCutoffDate      DateTime
  dueDate              DateTime
  billedDebtMinor      Int
  totalDebtMinor       Int
  isSettled            Boolean   @default(false)
  serverSeq            BigInt    @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account              Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, cycleCutoffDate])
  @@index([userId])
  @@index([accountId])
}

model CreditCardInstallmentPlan {
  id                          String        @id @default(uuid())
  userId                      String
  accountId                   String
  categoryId                  String?
  merchantName                String
  totalAmountMinor            Int
  tenureMonths                Int
  monthlyAmountMinor          Int
  finalInstallmentAmountMinor Int
  initialPaidInstallments     Int           @default(0)
  processingFeeMinor          Int           @default(0)
  processingFeeBilled         Boolean       @default(false)
  startDate                   DateTime
  firstStatementDate          DateTime
  isOngoingSetup              Boolean       @default(false)
  status                      String        @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  originalTransactionId       String?
  note                        String?
  serverSeq                   BigInt        @default(0)
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt
  deletedAt                   DateTime?

  user                        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account                     Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category                    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions                Transaction[] @relation("PlanTransactions")

  @@index([userId])
  @@index([accountId])
  @@index([serverSeq])
}

model BankSms {
  id               String       @id @default(uuid())
  userId           String
  dedupeKey        String       @unique
  sender           String
  rawMessage       String
  receivedAt       DateTime
  status           String       @default("PENDING") // PENDING | PROCESSED | NEEDS_REVIEW | IGNORED_NON_TX | DUPLICATE | FAILED
  parseMethod      String?      // TEMPLATE | GEMINI
  parsedPayload    Json?
  reviewReason     String?      // ACCOUNT_UNMATCHED | LOW_CONFIDENCE | VALIDATION_FAILED | NO_GEMINI_KEY | POSSIBLE_DUPLICATE
  attempts         Int          @default(0)
  nextRetryAt      DateTime?
  transactionId    String?
  failureReason    String?
  createdAt        DateTime     @default(now())

  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction      Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([transactionId])
}

model FixedDeposit {
  id                    String                @id @default(uuid())
  userId                String
  householdId           String?
  bankName              String
  accountNumber         String?
  principalAmountMinor  Int
  annualInterestRateBps Int
  tenureMonths          Int
  startDate             DateTime
  maturityDate          DateTime
  compoundingFrequency  String                @default("MONTHLY") // MONTHLY | QUARTERLY | ANNUALLY | AT_MATURITY
  payoutMode            String                @default("MONTHLY_PAYOUT_TO_ACCOUNT") // REINVEST_COMPOUND | MONTHLY_PAYOUT_TO_ACCOUNT
  linkedPayoutAccountId String?
  fundingAccountId      String?
  withholdingTaxRateBps Int                   @default(0)
  autoRenew             Boolean               @default(false)
  status                String                @default("ACTIVE") // ACTIVE | MATURED | CLOSED
  closedAt              DateTime?
  prematureClosure      Boolean               @default(false)
  serverSeq             BigInt                @default(0)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?

  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedPayoutAccount   Account?              @relation("FdPayoutAccount", fields: [linkedPayoutAccountId], references: [id], onDelete: SetNull)
  fundingAccount        Account?              @relation("FdFundingAccount", fields: [fundingAccountId], references: [id], onDelete: SetNull)
  payouts               FixedDepositPayout[]

  @@index([userId])
  @@index([status])
  @@index([maturityDate])
  @@index([serverSeq])
}

model FixedDepositPayout {
  id                 String       @id // UUIDv5 deterministic
  fixedDepositId     String
  periodEnd          DateTime
  grossInterestMinor Int
  taxWithheldMinor   Int
  netInterestMinor   Int
  transactionId      String?
  serverSeq          BigInt       @default(0)
  createdAt          DateTime     @default(now())

  fixedDeposit       FixedDeposit @relation(fields: [fixedDepositId], references: [id], onDelete: Cascade)
  transaction        Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([fixedDepositId])
  @@index([serverSeq])
}

model Loan {
  id                          String              @id @default(uuid())
  userId                      String
  householdId                 String?
  kind                        String              @default("LOAN") // LOAN | LEASE
  lenderName                  String
  originalPrincipalMinor      Int
  residualValueMinor          Int?                @default(0) // Balloon/residual for LEASE
  annualInterestRateBps       Int
  tenureMonths                Int
  startDate                   DateTime
  monthlyEmiAmountMinor       Int
  calculationType             String              @default("REDUCING_BALANCE") // REDUCING_BALANCE | FLAT_RATE
  linkedDisbursementAccountId String?
  status                      String              @default("ACTIVE") // ACTIVE | CLOSED
  closedAt                    DateTime?
  serverSeq                   BigInt              @default(0)
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  deletedAt                   DateTime?

  user                        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  disbursementAccount         Account?            @relation("LoanDisbursementAccount", fields: [linkedDisbursementAccountId], references: [id], onDelete: SetNull)
  scheduleEntries             LoanScheduleEntry[]
  payments                    LoanPayment[]

  @@index([userId])
  @@index([status])
  @@index([serverSeq])
}

model LoanScheduleEntry {
  id                      String        @id @default(uuid())
  loanId                  String
  installmentNumber       Int
  dueDate                 DateTime
  principalComponentMinor Int
  interestComponentMinor  Int
  openingBalanceMinor     Int
  closingBalanceMinor     Int
  status                  String        @default("SCHEDULED") // SCHEDULED | PAID | OVERRIDDEN
  serverSeq               BigInt        @default(0)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  deletedAt               DateTime?

  loan                    Loan          @relation(fields: [loanId], references: [id], onDelete: Cascade)
  payments                LoanPayment[]

  @@index([loanId])
  @@index([status])
  @@index([dueDate])
  @@index([serverSeq])
}

model LoanPayment {
  id                      String             @id @default(uuid())
  loanId                  String
  transactionId           String?
  scheduleEntryId         String?
  principalComponentMinor Int
  interestComponentMinor  Int
  isExtraPrincipal        Boolean            @default(false)
  paymentDate             DateTime           @default(now())
  serverSeq               BigInt             @default(0)
  createdAt               DateTime           @default(now())

  loan                    Loan               @relation(fields: [loanId], references: [id], onDelete: Cascade)
  transaction             Transaction?       @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  scheduleEntry           LoanScheduleEntry? @relation(fields: [scheduleEntryId], references: [id], onDelete: SetNull)

  @@index([loanId])
  @@index([transactionId])
  @@index([scheduleEntryId])
  @@index([paymentDate])
  @@index([serverSeq])
}
