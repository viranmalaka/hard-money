# Hard Money Environment Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hardmoney?schema=public"
AUTH_SECRET="insecure-dev-auth-secret-minimum-32-characters-long"
APP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
APP_URL="http://localhost:3000"

# Registration & Security
ALLOW_REGISTRATION="true"
CRON_SECRET="optional-cron-secret-token"

# E2E & Mocking
E2E_MODE="1"
GEMINI_PROVIDER="mock"

# Timezone & Localization
TZ="Asia/Colombo"

# Web Push (VAPID)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@hardmoney.local"
